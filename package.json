    "golf:build": "vite build --config prototypes/golf/vite.config.ts",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium chromium-headless-shell",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
